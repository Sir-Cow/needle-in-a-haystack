{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/needle-in-a-hay-stack",
        "sources": "https://github.com/Sir-Cow/needle-in-a-haystack",
        "issues": "https://github.com/Sir-Cow/needle-in-a-haystack/issues"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "sircow.needleinahaystack.FabricNeedleInAHaystack"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "~26.1",
        "java": ">=${java_version}"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.modrinth": "https://modrinth.com/mod/needle-in-a-hay-stack",
                "modmenu.curseforge": "https://curseforge.com/minecraft/mc-mods/needle-in-a-hay-stack"
            },
            "update_checker": true
        }
    }
}